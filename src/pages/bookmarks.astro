---
import HomeIcon from '../components/HomeIcon.astro'
import SiteFooter from '../components/SiteFooter.astro'

const pageTitle = 'Bookmarks — Ahyo'
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Ahyo 收藏的个人网站与网络角落。" />
    <link rel="icon" type="image/png" href="/images/site/ahyo-favicon.png" />
    <link rel="apple-touch-icon" href="/images/site/apple-touch-icon.png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <HomeIcon />
    <main>
      <h1>Bookmarks</h1>
      <p class="intro">一些我喜欢，也愿意常常回去看看的网络角落。</p>
      <ul class="bookmark-list">
        <li>
          <a href="https://blog.ryouissei.com/">
            <span class="bookmark-copy">
              <strong>觉论｜The Sense of Design &amp; Life</strong>
              <span>Issei's Blog</span>
              <small>blog.ryouissei.com</small>
            </span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; min-height: 100vh; color: var(--color-text); background: var(--color-bg); font-family: "Helvetica Neue", "PingFang SC", "Hiragino Sans", "Hiragino Kaku Gothic ProN", "Microsoft YaHei", Arial, sans-serif; font-weight: 400; }
  main { width: min(640px, calc(100% - 48px)); margin: 0 auto; padding: 160px 0 0; }
  h1 { margin: 0; font-size: clamp(1.55rem, 3vw, 1.75rem); font-weight: 500; line-height: 1.1; letter-spacing: -.03em; }
  .intro { margin: 28px 0 44px; font-size: .94rem; line-height: 1.85; }
  .bookmark-list {
    width: min(460px, 100%);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bookmark-list li + li { margin-top: 10px; }
  .bookmark-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 96px;
    padding: 17px 18px;
    color: inherit;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--color-border) 62%, transparent);
    border-radius: 5px;
    background: color-mix(in srgb, var(--color-panel) 32%, transparent);
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }
  .bookmark-copy {
    display: grid;
    gap: 5px;
    min-width: 0;
  }
  strong {
    font-size: .94rem;
    font-weight: 500;
    line-height: 1.35;
  }
  .bookmark-copy > span {
    font-size: .78rem;
    line-height: 1.45;
    opacity: .66;
  }
  small {
    margin-top: 3px;
    font-size: .68rem;
    letter-spacing: .015em;
    opacity: .46;
  }
  .arrow {
    flex: 0 0 auto;
    font-size: .9rem;
    opacity: 0;
    transform: translate(-5px, 5px);
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .bookmark-list a:hover,
  .bookmark-list a:focus-visible {
    color: var(--color-accent);
    background: var(--color-hover);
    border-color: var(--color-border);
    box-shadow: 0 7px 20px rgba(29, 41, 51, .07);
    transform: translateY(-2px);
    outline: none;
  }
  .bookmark-list a:hover .arrow,
  .bookmark-list a:focus-visible .arrow {
    opacity: .72;
    transform: translate(0, 0);
  }
  .bookmark-list a:active {
    box-shadow: none;
    transform: translateY(0) scale(.99);
  }
  @media (max-width: 700px) {
    main { padding-top: 116px; }
    .bookmark-list a { min-height: 88px; padding: 15px 16px; }
  }
</style>
